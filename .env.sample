# NFC API Server Configuration

# Port for the API server
PORT=3000

# Master key for key diversification (hex format)
MASTER_KEY_HEX=00000000000000000000000000000000

# Card reader name (update this to match your exact reader name)
CL_READER="ACS ACR1252 Dual Reader PICC"

# Enable debug logging (uncomment to enable)
# DEBUG=NTAG424:*

# MariaDB database configuration for tag mapping
DB_URL=jdbc:mariadb://localhost:3306/your_database_name
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password